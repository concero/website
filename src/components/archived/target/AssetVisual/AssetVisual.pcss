.asset_visual {
	position: relative;
	display: flex;
	justify-content: center;
	align-items: center;
	align-self: stretch;
	aspect-ratio: 856 / 515.63;
	width: 100%;
}

.asset_visual_flower {
	position: absolute;
	transform: translate(-50%, -50%);
	display: flex;
	width: 345px;
	height: 333px;
	justify-content: center;
	align-items: center;
}

.asset_visual_flower_image {
	width: 100%;
	height: 100%;
	object-fit: contain;
}

.protocol_visual {
	position: relative;
	display: flex;
	justify-content: center;
	align-items: center;
	align-self: stretch;
	aspect-ratio: 856 / 515.63;
	width: 100%;
}

.protocol_visual_icon {
	position: absolute;
	transform: translate(-50%, -50%);
	display: flex;
	width: 206px;
	height: 206px;
	justify-content: center;
	align-items: center;
}

.protocol_visual_icon_image {
	width: 100%;
	height: 100%;
	object-fit: contain;
}

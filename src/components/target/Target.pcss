.target {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: var(--space-xl) var(--space-xxl) var(--space-xxxl) var(--space-xxl);
	align-items: flex-start;
	gap: var(--space-xl);
}

.target_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 3rem;
	font-weight: 500;
	line-height: 3.5rem;
	letter-spacing: -0.96px;
}

.target_cards {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xl);
	width: 100%;
	min-width: 0;
}

.target_benefit_cards {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xl);
	width: 100%;
}

.target_actions {
	display: flex;
	justify-content: center;
	width: 100%;
	gap: var(--space-xxs);
}

.target_action_button {
	width: 218px !important;
	justify-content: center;
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.target_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.target_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}

	.target_cards {
		flex-direction: column;
		align-items: flex-start;
		min-width: 100%;
	}
}

@media (max-width: 640px) {
	.target {
		padding: var(--space-xl) var(--space-m) var(--space-xxxl) var(--space-m);
	}

	.target_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}

	.target_cards {
		flex-direction: column;
		align-items: flex-start;
		min-width: 100%;
	}

	.target_benefit_cards {
		flex-wrap: wrap;
		row-gap: 32px;
		column-gap: 16px;
	}
}

.overview_stack {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m);
	width: 100%;
	gap: var(--space-xxxl);
}

.overview_stack_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-xs);
}

.overview_stack_title {
	color: var(--color-gray-light-700);
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 500;
	line-height: 4.25rem;
	letter-spacing: -1.28px;
	text-align: center;
}

.overview_stack_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-light-600);
	text-align: center;
}

.overview_stack_content {
	display: flex;
	width: 100%;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
}

.overview_stack_cards {
	display: flex;
	align-items: center;
	gap: var(--space-xs);
	width: 100%;
}

.overview_stack_cards > * {
	flex: 1 1 0;
}

@media (min-width: 641px) and (max-width: 1024px) {
	.overview_stack_cards > :first-child {
		flex: 0 0 34%;
	}
	.overview_stack_cards > :not(:first-child) {
		flex: 1 1 calc((100% - 34%) / 3);
	}
}

@media (min-width: 641px) and (max-width: 1919px) {
	.overview_stack_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (max-width: 640px) {
	.overview_stack_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}

	.overview_stack_cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-template-rows: repeat(2, auto);
		gap: var(--space-xs);
		width: 100%;
	}
}

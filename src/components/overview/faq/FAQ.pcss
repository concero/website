.overview_faq {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m);
	width: 100%;
	gap: var(--space-xxxl);
}

.overview_faq_title {
	color: var(--color-gray-light-700);
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 500;
	line-height: 4.25rem;
	letter-spacing: -1.28px;
	text-align: center;
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.overview_faq_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.overview_faq_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (max-width: 640px) {
	.overview_faq_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

.overview_hero {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	width: 100%;
	height: calc(100vh - 64px);
	margin-top: 64px;
}

.overview_hero_container {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: calc(var(--space-xxxxxl) - var(--space-m)) var(--space-m) var(--space-xxxl) var(--space-m);
	height: 100%;
	gap: var(--space-xl);
}

.overview_hero_content {
	display: flex;
	flex-direction: column;
	gap: var(--space-m);
	width: 100%;
	align-items: flex-start;
}

.overview_hero_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
	width: 100%;
}

.overview_hero_title_container {
	display: flex;
	flex-direction: column;
	gap: var(--space-xxs);
	align-items: center;
}

.overview_hero_actions {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.overview_hero_title {
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 400;
	line-height: 4.25rem;
	color: var(--color-gray-light-700);
	letter-spacing: -1.28px;
	text-align: center;
}

.overview_hero_title_gray {
	color: var(--color-gray-500);
}

.overview_hero_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-light-600);
	text-align: center;
}

.overview_hero_action {
	border-radius: var(--border-radius-xlarge) !important;
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.overview_hero {
		height: calc(100vh - 48px);
		margin-top: 48px;
	}

	.overview_hero_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.overview_hero {
		height: calc(100vh - 48px);
		margin-top: 48px;
	}

	.overview_hero_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}
}

@media (max-width: 640px) {
	.overview_hero {
		height: calc(100vh - 48px);
		margin-top: 48px;
	}

	.overview_hero_container {
		padding: var(--space-xxxl) var(--space-m) var(--space-xxxl) var(--space-m);
	}

	.overview_hero_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}
}

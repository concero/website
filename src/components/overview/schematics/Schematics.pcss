.overview_schematics {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m) var(--space-m);
	width: 100%;
	gap: var(--space-xxxl);
}

.overview_schematics_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	gap: var(--space-xs);
}

.overview_schematics_title {
	color: var(--color-gray-light-700);
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 500;
	line-height: 4.25rem;
	letter-spacing: -1.28px;
	text-align: center;
}

.overview_schematics_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-light-600);
	text-align: center;
}

.overview_schematics_cards {
	display: flex;
	flex-direction: row;
	justify-content: center;
	padding: 0 var(--space-l);
	gap: var(--space-xl);
	width: 100%;
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.overview_schematics_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.overview_schematics_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (max-width: 640px) {
	.overview_schematics_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}
}

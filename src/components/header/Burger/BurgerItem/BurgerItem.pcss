.burger_item_link {
	display: block;
	width: 100%;
	text-decoration: none;
}

.burger_item {
	display: flex;
	padding: var(--space-xxs) var(--space-l) var(--space-xxs) var(--space-xxs);
	align-items: center;
	cursor: pointer;
	border-radius: var(--border-radius-large);
	gap: var(--space-s);
	background-color: var(--color-gray-light-25);
	transition:
		background-color 0.2s ease,
		transform 0.2s ease;
}

a:hover .burger_item {
	background-color: var(--color-gray-light-50);
	transform: translateY(-1px);
}

.burger_item_icon_container {
	display: flex;
	align-items: center;
	justify-content: center;
	min-width: 48px;
	min-height: 48px;
	border-radius: var(--border-radius-medium);
	background-color: var(--color-gray-light-50);
	transition: background-color 0.2s ease;
}

a:hover .burger_item_icon_container {
	background-color: #f3f1fe;
}

.burger_icon_wrapper {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 24px;
	height: 24px;
}

.burger_icon_wrapper svg {
	transition: color 0.2s ease;
}

a:hover .burger_icon_wrapper svg path,
a:hover .burger_icon_wrapper svg rect {
	fill: #7e54f1;
	transition: fill 0.2s ease;
}

.burger_text_container {
	display: flex;
	flex-direction: column;
	justify-content: center;
	width: 100%;
	gap: var(--space-xxs);
}

.burger_title_section {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-xs);
}

.burger_item_title {
	font-family: var(--font-body-xlarge-family);
	font-size: 1rem;
	font-weight: 500;
	line-height: 1.25rem;
	color: var(--color-gray-light-600);
	transition: color 0.2s ease;
}

a:hover .burger_item_title {
	color: var(--color-gray-light-700);
}

.burger_item_subtitle {
	font-family: var(--font-body-medium-family);
	font-size: 0.875rem;
	font-weight: 400;
	line-height: 1.125rem;
	color: var(--color-gray-light-400);
	transition: color 0.2s ease;
}

.burger_item_link_disabled {
	cursor: not-allowed;
	pointer-events: none;
	text-decoration: none;
}

.burger_item_disabled {
	background-color: var(--color-gray-light-10);
	cursor: not-allowed;
	transition: none;
	transform: none;
	color: var(--color-gray-light-400);
}

.burger_item_disabled .burger_item_title,
.burger_item_disabled .burger_item_subtitle {
	color: var(--color-gray-light-400);
}

.burger_item_disabled .burger_item_icon_container {
	background-color: var(--color-gray-50);
	transition: none;
}

.burger_item_disabled .burger_icon_wrapper svg path,
.burger_item_disabled .burger_icon_wrapper svg rect {
	fill: var(--color-gray-light-400);
	transition: none;
}

.burger_item_tag {
	white-space: nowrap;
}

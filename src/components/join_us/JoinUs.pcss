.join_us {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: var(--space-xl) var(--space-xxl) var(--space-xxxl) var(--space-xxl);
	align-items: flex-start;
	gap: var(--space-xl);
}

.join_us_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	width: 100%;
	gap: var(--space-xs);
}

.join_us_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 3rem;
	font-weight: 500;
	line-height: 3.5rem;
	letter-spacing: -0.96px;
}

.join_us_subtitle {
	color: var(--color-gray-600);
	font-family: var(--font-body-medium-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	letter-spacing: -0.64px;
}

.join_us_content {
	display: flex;
	flex-direction: column;
	width: 100%;
	gap: var(--space-m);
}

.join_us_content_row {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 100%;
	gap: var(--space-m);
}

.join_us_content_row > * {
	flex: 1 1 0;
	min-width: 0;
	max-width: calc(50% - var(--space-m) / 2);
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.join_us_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}

	.join_us_subtitle {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.join_us_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}

	.join_us_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}

	.join_us_content_row {
		flex-direction: column;
	}

	.join_us_content_row > * {
		max-width: 100%;
		flex: 1 1 auto;
	}
}

@media (max-width: 640px) {
	.join_us {
		padding: var(--space-xl) var(--space-m) var(--space-xxxl) var(--space-m);
	}

	.join_us_title {
		font-size: 2rem;
		line-height: 2.25rem;
	}

	.join_us_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}

	.join_us_content_row {
		flex-direction: column;
	}

	.join_us_content_row > * {
		max-width: 100%;
		flex: 1 1 auto;
	}
}

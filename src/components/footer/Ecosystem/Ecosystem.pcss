.ecosystem_wrapper {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: var(--space-xl);
	max-width: 904px;
	width: 100%;
}

.ecosystem_section {
	display: flex;
	flex-direction: column;
	width: 100%;
	align-items: flex-start;
	gap: var(--space-xs);
}

.ecosystem_title {
	width: 100%;
	font-family: var(--font-body-medium-family);
	font-size: 0.875rem;
	font-weight: 400;
	line-height: 1.125rem;
	color: var(--color-gray-light-500);
}

.ecosystem_links {
	display: flex;
	flex-direction: column;
	gap: var(--space-xs);
	width: 100%;
}

.ecosystem_link {
	display: flex;
	align-items: center;
	font-family: var(--font-body-medium-family);
	font-size: 1rem;
	font-weight: 400;
	line-height: 1.125rem;
	color: var(--color-gray-light-600);
	text-decoration: none;
	transition: color 0.2s ease;
	min-height: 32px;
}

.ecosystem_link:hover {
	color: var(--color-gray-light-700);
}

@media (max-width: 640px) {
	.ecosystem_wrapper {
		flex-direction: row;
		flex-wrap: wrap;
		width: 100%;
		gap: var(--space-m);
	}

	.ecosystem_section {
		width: calc(50% - var(--space-m) / 2);
		flex-shrink: 0;
	}
}

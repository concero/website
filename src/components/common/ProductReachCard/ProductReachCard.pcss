.product_reach_card {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	padding: var(--space-l);
	width: 100%;
	gap: var(--space-l);
	border-radius: var(--border-radius-xlarge);
	background-color: var(--color-gray-50);
}

.product_reach_card_header {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-xs);
	width: 100%;
}

.product_reach_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 3rem;
	font-weight: 500;
	line-height: 3.5rem;
	letter-spacing: -0.96px;
}

.product_reach_card_detail {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xs);
	width: 100%;
}

.product_reach_card_bullet {
	flex: 0 0 10px;
	height: 10px;
	background-color: var(--color-accent-600);
	border-radius: 50%;
	margin-top: 6px;
}

.product_reach_card_text {
	flex: 1;
	color: var(--color-gray-600);
	font-family: var(--font-heading-medium-family);
	font-size: 1rem;
	font-weight: 400;
	line-height: 1.25rem;
}

.product_reach_card_action {
	display: flex;
	width: 100%;
}

.product_reach_card_visual {
	width: 100%;
	height: 368px;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: var(--border-radius-large);
	background-color: var(--color-gray-25);
}

.product_reach_card_action_button {
	border-radius: var(--border-radius-xlarge) !important;
}

@media (min-width: 641px) and (max-width: 1919px) {
	.product_reach_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
		width: 100%;
	}
}

@media (max-width: 640px) {
	.product_reach_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}
}

.product_reach_card {
	display: flex;
	padding: var(--space-xs);
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-l);
	flex: 1 0 0;
	border-radius: var(--space-xl);
	background: var(--color-gray-50);
}
.product_reach_card_heading {
	display: flex;
	padding: var(--space-m);
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-l);
	align-self: stretch;
}
.product_reach_card_header {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-xs);
	align-self: stretch;
}

.product_reach_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 3rem;
	font-weight: 500;
	line-height: 3.5rem;
	letter-spacing: -0.96px;
}

.product_reach_card_detail {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xs);
	width: 100%;
}

.product_reach_card_text {
	flex: 1;
	color: var(--color-gray-600);
	font-family: var(--font-heading-medium-family);
	font-size: 1rem;
	font-weight: 400;
	line-height: 1.25rem;
}

.product_reach_card_action {
	display: flex;
	width: 100%;
}

.product_reach_card_visual {
	width: 100%;
	height: 383.333px;
	display: flex;
	justify-content: center;
	margin-top: auto;
	align-items: center;
	border-radius: var(--border-radius-large);
	overflow: auto;
	& > * > *{
		height: 100% !important;
	}
}

.product_reach_card_action_button {
	border-radius: var(--border-radius-xlarge) !important;
}

@media (min-width: 641px) and (max-width: 1919px) {
	.product_reach_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
		width: 100%;
	}
}

@media (max-width: 640px) {
	.product_reach_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}
}

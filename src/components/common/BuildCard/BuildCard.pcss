.build_card {
	display: flex;
	width: 1384px;
	max-width: 100%;
	padding: var(--space-xs);
	align-items: center;
	gap: 10px;
	background: var(--color-gray-50);
	border-radius: var(--space-xl);
	&_inverse {
		& > :first-child {
			order: 2;
		}
		& > :last-child {
			order: 1;
		}
	}
	&_column {
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
	}

	@media screen and (width < 1920px) and (width > 1279px) {
		width: 904px;
	}
}

.build_card_visual {
	width: 100%;
	background-color: var(--color-gray-50);
	height: 401.662px;
	flex: 1 0 0;
	aspect-ratio: 679/401.66;
	border-radius: var(--space-l);
	max-width: 50%;
	& > * > * {
		overflow: auto;
		width: 100% !important;
		border-radius: var(--space-l);
	}

	@media screen and (width < 1279px) {
		max-width: 100%;
	}
}

.build_card_content {
	display: flex;
	padding: var(--space-m);
	flex-direction: column;
	justify-content: center;
	align-items: flex-start;
	gap: var(--space-l);
	flex: 1 0 0;
}

.build_card_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-s);
	align-self: stretch;
}

.build_card_title {
	color: var(--color-gray-700);
	font: var(--font-heading-xxlarge);
	font-size: 40px;
	font-style: normal;
	font-weight: 500;
	line-height: 48px; /* 120% */
	letter-spacing: -0.8px;
	@media screen and (width < 1920px) and (width > 744px) {
		font: var(--font-heading-xxlarge);
	}
	@media screen and (width < 744px) {
		font: var(--font-heading-xlarge);
	}
}

.build_card_bullets {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-s);
	align-self: stretch;
	width: 100%;
}

.build_card_bullet {
	flex: 0 0 8px;
	height: 8px;
	width: 8px;
	background-color: var(--color-accent-600);
	border-radius: 50%;
	margin-top: 6px;
}

.build_card_text {
	flex: 1;
	color: var(--color-gray-600);
	font: var(--font-heading-medium);
}

.build_card_bullet_item {
	display: flex;
	align-items: flex-start;
	gap: var(--space-s);
}

.build_card_action {
	border-radius: var(--border-radius-xlarge) !important;
}

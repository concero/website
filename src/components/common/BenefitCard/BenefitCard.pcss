.benefit_card {
	display: flex;
	flex-direction: column;
	gap: var(--space-s);
	width: 100%;
}

.benefit_card_icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 72px;
	height: 72px;
	border-radius: var(--border-radius-large);
	background-color: var(--color-gray-50);
}

.benefit_card_icon svg {
	width: 24px;
	height: 24px;
}

.benefit_card_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.benefit_card_title {
	color: var(--color-gray-700);
	font: var(--font-heading-xxlarge);
	@media (min-width: 1280px) and (max-width: 1919px) {
		font: var(--font-heading-xxlarge);
	}
	@media (max-width: 1279px) {
		font: var(--font-heading-xlarge);
	}
}

.benefit_card_text {
	color: var(--color-gray-600);
	font: var(--font-heading-xlarge);
	@media (max-width: 1919px) {
		font: var(--font-heading-large);
	}
}

@media (max-width: 1919px) {
	.benefit_card_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
	}
	.benefit_card_text {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (max-width: 640px) {
	.benefit_card {
		width: calc(50% - var(--space-xs));
		min-width: calc(50% - var(--space-xs));
		flex-shrink: 0;
	}
}

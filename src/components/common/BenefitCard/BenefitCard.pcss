.benefit_card {
	display: flex;
	flex-direction: column;
	gap: var(--space-s);
	width: 100%;
}

.benefit_card_icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 72px;
	height: 72px;
	border-radius: var(--border-radius-large);
	background-color: var(--color-gray-50);
}

.benefit_card_icon svg {
	width: 24px;
	height: 24px;
}

.benefit_card_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.benefit_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-body-medium-family);
	font-size: 2rem;
	font-weight: 500;
	line-height: 2.25rem;
	letter-spacing: -0.48px;
}

.benefit_card_text {
	color: var(--color-gray-600);
	font-family: var(--font-body-medium-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
}

@media (max-width: 1919px) {
	.benefit_card_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
	}
	.benefit_card_text {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (max-width: 640px) {
	.benefit_card {
		width: calc(50% - var(--space-xs));
		min-width: calc(50% - var(--space-xs));
		flex-shrink: 0;
	}
}

.benefit_card {
	display: flex;
	flex-direction: column;
	gap: var(--space-s);
	width: 100%;
}

.benefit_card_icon {
	width: 24px;
	height: 24px;
	flex-shrink: 0;
	aspect-ratio: 1 / 1;
}

.benefit_card_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.benefit_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-body-medium-family);
	font-size: 1.5rem;
	font-weight: 500;
	line-height: 1.75rem;
	letter-spacing: -0.48px;
}

.benefit_card_text {
	color: var(--color-gray-600);
	font-family: var(--font-body-medium-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.benefit_card_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}

	.benefit_card_text {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.benefit_card_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}

	.benefit_card_text {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (max-width: 640px) {
	.benefit_card_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}

	.benefit_card_text {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (max-width: 640px) {
	@media (max-width: 640px) {
		.benefit_card {
			width: calc(50% - var(--space-xs));
			min-width: calc(50% - var(--space-xs));
			flex-shrink: 0;
		}
	}
}

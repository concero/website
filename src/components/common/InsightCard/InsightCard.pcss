.insight_card {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-s);
	width: 100%;
}

.insight_card_content {
	display: flex;
	align-items: center;
	gap: var(--space-s);
	width: 100%;
}

.insight_icon {
	width: 64px;
	height: 64px;
	flex-shrink: 0;
	aspect-ratio: 1 / 1;
	border-radius: var(--border-radius-large);
}

.insight_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 1.5rem;
	font-weight: 500;
	line-height: 1.75rem;
	letter-spacing: -0.48px;
}

.insight_divider {
	height: 1px;
	width: 100%;
	background-color: var(--color-gray-100);
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.insight_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.insight_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}
}

@media (max-width: 640px) {
	.insight_title {
		font-size: 1.125rem;
		line-height: 1.375rem;
	}
}

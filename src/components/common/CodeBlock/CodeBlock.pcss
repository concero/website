.code_block {
	display: flex;
	padding: var(--space-xl);
	flex-direction: column;
	align-items: flex-start;
	min-height: 720px;
	width: 100%;
	border-radius: var(--border-radius-xlarge);
	background-color: var(--color-gray-50);
}

.code_block_pre {
	margin: 0;
	width: 100%;
	text-overflow: ellipsis;
	white-space: pre;
	overflow: hidden;
}

.typed-text-accent {
	color: var(--color-accent-600) !important;
	font-weight: 500;
}

code[class*='language-'],
pre[class*='language-'] {
	color: var(--color-gray-600);
	overflow: hidden;
	font-size: 1.5rem;
	font-family: Menlo, Monaco, 'Courier New', monospace;
	text-align: left;
	white-space: pre;
	word-spacing: normal;
	word-break: normal;
	line-height: 1.75;
}

.token.comment,
.token.prolog,
.token.doctype,
.token.cdata {
	color: var(--color-success-500);
}

.token.punctuation {
	color: var(--color-gray-600);
}

.token.property,
.token.tag,
.token.boolean,
.token.number,
.token.constant,
.token.symbol,
.token.deleted {
	color: var(--color-danger-600);
}

.token.selector,
.token.attr-name,
.token.string,
.token.char,
.token.builtin {
	color: var(--color-warning-400);
}

.token.operator,
.token.entity,
.token.url,
.language-css .token.string,
.style .token.string {
	color: var(--color-gray-600);
}

.token.atrule,
.token.attr-value,
.token.keyword {
	color: var(--color-success-400);
}

.token.function,
.token.class-name {
	color: #3ab7f5;
}

.token.regex,
.token.important,
.token.variable {
	color: #4ec9b0;
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.code_block {
		min-height: 368px;
	}

	code[class*='language-'],
	pre[class*='language-'] {
		font-size: 1rem;
		line-height: 1.25;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.code_block {
		min-height: 368px;
	}

	code[class*='language-'],
	pre[class*='language-'] {
		font-size: 1rem;
		line-height: 1.25;
	}
}

@media (max-width: 640px) {
	.code_block {
		padding: var(--space-l);
		min-height: 368px;
	}

	code[class*='language-'],
	pre[class*='language-'] {
		font-size: 0.875rem;
		line-height: 1.125;
	}
}

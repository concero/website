.role_card {
	display: flex;
	padding: var(--space-l);
	gap: var(--space-l);
	flex: 1 0 0;
	width: 100%;
	border-radius: var(--border-radius-xlarge);
	background-color: var(--color-gray-50);
}

.role_card_content {
	display: flex;
	flex-direction: column;
	gap: var(--space-m);
	flex: 1 0 0;
	align-items: flex-start;
}

.role_card_description {
	display: flex;
	flex-direction: column;
	gap: var(--space-xxs);
	width: 100%;
	align-items: flex-start;
}

.role_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 2rem;
	font-weight: 500;
	line-height: 2.25rem;
	letter-spacing: -0.64px;
}

.role_card_subtitle {
	color: var(--color-gray-600);
	font-family: var(--font-heading-medium-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
}

.role_card_tags {
	display: flex;
	align-items: flex-start;
	flex-wrap: wrap;
	gap: var(--space-m);
}

.role_card_visual {
	flex: 1 0 0;
	width: 100%;
	border-radius: var(--border-radius-large);
}

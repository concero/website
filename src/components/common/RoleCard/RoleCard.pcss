.role_card {
	display: flex;
	padding: var(--space-l);
	gap: var(--space-l);
	width: 100%;
	border-radius: var(--border-radius-xlarge);
	background-color: var(--color-gray-50);
}

.role_card_content {
	display: flex;
	flex-direction: column;
	gap: var(--space-m);
	flex: 1 0 0;
	align-items: flex-start;
}

.role_card_description {
	display: flex;
	flex-direction: column;
	gap: var(--space-xxs);
	width: 100%;
	align-items: flex-start;
}

.role_card_title {
	color: var(--color-gray-700);
	font-family: var(--font-heading-medium-family);
	font-size: 2rem;
	font-weight: 500;
	line-height: 2.25rem;
	letter-spacing: -0.64px;
}

.role_card_subtitle {
	color: var(--color-gray-600);
	font-family: var(--font-heading-medium-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
}

.role_card_tags {
	display: flex;
	align-items: flex-start;
	flex-wrap: wrap;
	gap: var(--space-xs);
}

.role_card_visual {
	width: 100%;
	flex: 1 0 0;
	border-radius: var(--border-radius-large);
	overflow: hidden;
}

.role_card_visual img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.role_card_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
	}

	.role_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}

	.role_card_visual {
		height: 195px;
		aspect-ratio: 4 / 3;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.role_card_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
	}

	.role_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}

	.role_card_visual {
		height: 222px;
		aspect-ratio: 4 / 3;
	}
}

@media (max-width: 640px) {
	.role_card {
		flex-direction: column-reverse;
	}

	.role_card_title {
		font-size: 1.5rem;
		line-height: 1.75rem;
	}

	.role_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}

	.role_card_visual {
		flex: none;
		height: 192px;
		aspect-ratio: 4 / 3;
	}
}

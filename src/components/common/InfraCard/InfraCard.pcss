.infra_card {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	width: 100%;
}

.infra_card_visual {
	display: flex;
	height: 277px;
	padding: var(--space-l);
	border-radius: var(--border-radius-xlarge);
	background-color: var(--color-gray-50);
	width: 100%;
}

.infra_card_content {
	display: flex;
	padding: var(--space-m);
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-l);
	width: 100%;
}

.infra_card_description {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-xs);
	width: 100%;
}

.infra_card_title {
	font-family: var(--font-heading-large-family);
	font-size: 3rem;
	font-weight: 500;
	line-height: 3.5rem;
	color: var(--color-gray-700);
	letter-spacing: -0.96px;
}

.infra_card_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-600);
}

.infra_card_action {
	border-radius: var(--border-radius-xlarge) !important;
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.infra_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}

	.infra_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.infra_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}

	.infra_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

@media (max-width: 640px) {
	.infra_card_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}

	.infra_card_subtitle {
		font-size: 1rem;
		line-height: 1.25rem;
	}
}

.lanca_schematics {
	display: flex;
	min-width: 1280px;
	max-width: 1920px;
	padding: var(--space-xxxxxxl) var(--space-xs) var(--space-xs) var(--space-xs);
	flex-direction: column;
	align-items: center;
	gap: var(--space-xxl);
	align-self: stretch;
	background: var(--color-gray-25);

	@media (min-width: 1280px) and (max-width: 1919px) {
		width: 100%;
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		min-width: initial;
		max-width: 100%;
	}
	@media (max-width: 743px) {
		min-width: initial;
		max-width: 100%;
	}
}

.lanca_schematics_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	gap: var(--space-xs);
}

.lanca_schematics_title {
	color: var(--color-gray-light-700);
	font: var(--font-heading-xxxxlarge);
	@media (min-width: 1280px) and (max-width: 1919px) {
		font: var(--font-heading-xxxlarge);
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		font: var(--font-heading-xxxlarge);
	}
	@media (max-width: 743px) {
		font: var(--font-heading-xxlarge);
	}
}

.lanca_schematics_visual_wrapper {
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: var(--space-l);
}

.lanca_schematics_image_container {
	width: 100%;
	display: flex;
	justify-content: center;
	position: relative;
}

.lanca_schematics_image {
	width: 100%;
	height: auto;
	user-select: none;
	pointer-events: none;
	-webkit-user-drag: none;
}

.lanca_schematics_cards_outer {
	position: relative;
	width: 100%;
}

.lanca_schematics_cards_wrapper {
	width: 100%;
	overflow-x: auto;
	scroll-behavior: smooth;
	scrollbar-width: none;
	-ms-overflow-style: none;
}

.lanca_schematics_cards_wrapper::-webkit-scrollbar {
	display: none;
}

.lanca_overflow_shadow::after {
	content: '';
	position: absolute;
	top: 0;
	right: 0;
	width: 24px;
	height: 100%;
	pointer-events: none;
	background: linear-gradient(90deg, rgba(252, 252, 253, 0) 0%, var(--color-gray-25, #fcfcfd) 100%);
	transition: opacity 0.3s ease;
	opacity: 1;
}

.lanca_overflow_shadow::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	width: 24px;
	height: 100%;
	pointer-events: none;
	background: linear-gradient(-90deg, rgba(252, 252, 253, 0) 0%, var(--color-gray-25, #fcfcfd) 100%);
	transition: opacity 0.3s ease;
	opacity: 1;
}

.lanca_schematics_cards {
	display: flex;
	flex-direction: row;
	justify-content: flex-start;
	padding: 0 var(--space-l);
	gap: var(--space-xl);
	width: 100%;
}

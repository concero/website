.lanca_build {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m) var(--space-m);
	width: 100%;
	gap: var(--space-xxl);
}

.lanca_build_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-m);
}

.lanca_build_description_heading {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
}

.lanca_build_description_action {
	border-radius: var(--border-radius-xlarge) !important;
}

.lanca_build_description_title {
	color: var(--color-gray-light-700);
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 500;
	line-height: 4.25rem;
	letter-spacing: -1.28px;
	text-align: center;
}

.lanca_build_description_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-light-600);
	text-align: center;
}

.lanca_build_card {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-xs);
	width: 100%;
	justify-content: center;
}

.lanca_build_card > * {
	flex: 1 1 calc(25% - var(--space-xs));
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.lanca_build_description_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.lanca_build_card > * {
		flex: 1 1 calc(50% - var(--space-xs) / 2);
	}

	.lanca_build_description_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (max-width: 640px) {
	.lanca_build_card > * {
		flex: 1 1 100%;
	}

	.lanca_build_description_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}
}

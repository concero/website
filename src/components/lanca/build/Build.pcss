.lanca_build {
	display: flex;
	flex-direction: column;
	align-items: center;
	max-width: 1920px;
	padding: var(--space-xxxxxxl) var(--space-xs) var(--space-xs) var(--space-xs);
	width: 100%;
	gap: var(--space-xxl);

	@media (min-width: 1280px) and (max-width: 1919px) {
		width: 100%;
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		width: 100%;
	}
	@media (max-width: 743px) {
		width: 100%;
	}
}

.lanca_build_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-m);
}

.lanca_build_description_heading {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
}

.lanca_build_description_action {
	border-radius: var(--border-radius-xlarge) !important;
}

.lanca_build_description_title {
	color: var(--color-gray-light-700);

	font: var(--font-heading-xxxxlarge);
	@media (min-width: 1280px) and (max-width: 1919px) {
		font: var(--font-heading-xxxlarge);
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		font: var(--font-heading-xxxlarge);
	}
	@media (max-width: 743px) {
		font: var(--font-heading-xxlarge);
	}
}

.lanca_build_description_subtitle {
	font-family: var(--font-heading-large-family);
	font-size: 1.125rem;
	font-weight: 400;
	line-height: 1.375rem;
	color: var(--color-gray-light-600);
	text-align: center;
}

.lanca_build_card {
	display: flex;
	gap: var(--space-xs);
	width: 100%;
	justify-content: center;
	@media (max-width: 743px) {
		flex-direction: column;
	}
}

.lanca_build_card > * {
	flex: 1 1 calc(25% - var(--space-xs));
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.lanca_build_description_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.lanca_build_card > * {
		flex: 1 1 calc(50% - var(--space-xs) / 2);
	}

	.lanca_build_description_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.64px;
	}
}

@media (max-width: 640px) {
	.lanca_build_card > * {
		flex: 1 1 100%;
	}

	.lanca_build_description_title {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.64px;
	}
}

.lanca_benefits {
	display: flex;
	flex-direction: column;
	padding: var(--space-xl);
	align-items: center;
	gap: var(--space-xl);
	width: 100%;
}

.lanca_benefits_cards {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xl);
	width: 100%;
}

@media (max-width: 640px) {
	.lanca_benefits_cards {
		flex-wrap: wrap;
		row-gap: var(--space-l);
		column-gap: var(--space-m);
	}
}

.lanca_benefits {
	display: flex;
	min-width: 1280px;
	max-width: 1920px;
	width: 100%;
	padding: var(--space-xl);
	flex-direction: column;
	align-items: center;
	gap: var(--space-xl);
	align-self: stretch;
	@media (max-width: 1279px) {
		width: 100%;
		max-width: 100%;
		min-width: initial;
	}
	@media (max-width: 743px) {
		padding: var(--space-xl) var(--spacTe-m);
	}
}

.lanca_benefits_cards {
	display: flex;
	max-width: 1920px;
	padding: var(--space-xl);
	align-items: center;
	gap: var(--space-xl);
	align-self: stretch;
	@media (min-width: 1280px) and (max-width: 1919px) {
		/* width: 1280px; */
	}
	@media (max-width: 743px) {
		display: flex;
		width: 100%;
		padding: var(--space-xl) var(--space-m);
		align-items: center;
		align-self: stretch;
		flex-direction: column;
		row-gap: var(--space-l);
		column-gap: var(--space-m);
	}
}

.lanca_benefits {
	display: flex;
	min-width: 1280px;
	max-width: 1920px;
	width: 100%;
	padding: var(--space-xl);
	flex-direction: column;
	align-items: center;
	gap: var(--space-xl);
	align-self: stretch;
	@media (max-width: 1279px) {
		width: 100%;
		max-width: 100%;
		min-width: initial;
	}
	@media (max-width: 743px) {
		padding: var(--space-space-2, 32px) var(--space-space-1, 16px);
	}
}

.lanca_benefits_cards {
	display: flex;
	align-items: flex-start;
	gap: var(--space-xl);
	width: 100%;
}

@media (max-width: 640px) {
	.lanca_benefits_cards {
		flex-wrap: wrap;
		row-gap: var(--space-l);
		column-gap: var(--space-m);
	}
}

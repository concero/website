.lanca_hero {
	padding: var(--space-xxxl) var(--space-xs) var(--space-xs) var(--space-xs);
	aspect-ratio: 1920 / 1024;
	@media (min-width: 1280px) and (max-width: 1919px) {
		padding: var(--space-xxxl) var(--space-xs) var(--space-xs) var(--space-xs);
		aspect-ratio: 1280 / 720;
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		padding: 56px var(--space-xs) var(--space-xs) var(--space-xs);
		aspect-ratio: 744 / 1133;
	}
	@media (max-width: 743px) {
		padding: 56px var(--space-xs) var(--space-xs) var(--space-xs);
		aspect-ratio: 375 / 667;
	}
	.lanca_hero_content {
		padding: var(--space-xs);
		display: flex;
		height: 100%;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-l);
		align-self: stretch;
		flex: 1 0 0;
		background: var(--color-gray-50);
		border-radius: var(--space-xl);
	}
	.lanca_hero_backgroung_animation_wrap {
		width: 100%;
		height: 100%;
		display: flex;
		justify-content: center;
		margin-top: auto;
		align-items: center;
		border-radius: var(--border-radius-large);
		overflow: auto;
		@media (min-width: 1280px) and (max-width: 1919px) {
			/* height: 398px; */
		}
		@media (min-width: 744px) and (max-width: 1279px) {
			/* height: 795px; */
		}
		@media (max-width: 743px) {
			/* height: 251px; */
		}

		& > * > * {
			border-radius: var(--border-radius-large);
		}
	}
}

.lanca_hero_heading {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: var(--space-m);
	align-self: stretch;
	width: 100%;
	z-index: 1;
	.lanca_hero_description {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
		align-self: stretch;
		.lanca_hero_title_container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-xxs);

			.lanca_hero_title {
				font: var(--font-heading-xxxxlarge);
				text-align: center;
				color: var(--color-gray-700);
				@media (min-width: 1280px) and (max-width: 1919px) {
					font: var(--font-heading-xxxlarge);
				}
				@media (min-width: 744px) and (max-width: 1279px) {
					font: var(--font-heading-xxxlarge);
				}
				@media (max-width: 743px) {
					font: var(--font-heading-xxlarge);
				}
			}
			.lanca_hero_subtitle {
				font: var(--font-heading-xxxxlarge);
				text-align: center;
				color: var(--color-gray-500);
				@media (min-width: 1280px) and (max-width: 1919px) {
					font: var(--font-heading-xxxlarge);
				}
				@media (min-width: 744px) and (max-width: 1279px) {
					font: var(--font-heading-xxxlarge);
				}
				@media (max-width: 743px) {
					font: var(--font-heading-xxlarge);
				}
			}
		}
		.lanca_hero_subtitle_description {
			font: var(--font-heading-large);
			text-align: center;
			color: var(--color-gray-600);
		}
	}
	.lanca_hero_actions_wrap {
		display: flex;
		justify-content: center;
		max-width: 100%;
		.lanca_hero_actions {
			display: flex;
			justify-content: center;
			align-items: center;
			align-self: stretch;
			gap: var(--space-xs);
			width: 440px;
			max-width: 100%;
			padding: 0 var(--space-m) var(--space-m) var(--space-m);
			@media (min-width: 1280px) and (max-width: 1919px) {
				width: 436px;
			}
			@media (min-width: 744px) and (max-width: 1279px) {
				width: 502px;
			}
			@media (max-width: 743px) {
			}
			@media (width < 744px) {
				flex-direction: column;
			}
		}
	}
}

.lanca_hero_backgroung_animation {
	display: flex;
	flex: 1 0 0;
	align-self: stretch;
	height: 100%;
	/* min-height: 500px; */
	width: 100% !important;
	border-radius: var(--space-xl);
}

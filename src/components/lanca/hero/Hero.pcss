.lanca_hero {
	display: flex;
	height: 1024px;
	min-width: 1280px;
	max-width: 1920px;
	padding: 192px var(--space-xs) var(--space-xs) var(--space-xs);
	flex-direction: column;
	align-items: center;
	gap: var(--space-xl);
	align-self: stretch;
}

.lanca_hero_heading {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-m);
	align-self: stretch;
	width: 100%;
	z-index: 1;
}
.lanca_hero_description {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
	align-self: stretch;
}

.lanca_hero_title_container {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xxs);
}

.lanca_hero_title {
	font: var(--font-heading-xxxxlarge);
	text-align: center;
	color: var(--color-gray-700);
}

.lanca_hero_subtitle {
	font: var(--font-heading-xxxxlarge);
	text-align: center;
	color: var(--color-gray-500);
}
.lanca_hero_subtitle_description {
	font: var(--font-heading-large);
	text-align: center;
	color: var(--color-gray-600);
}

.lanca_hero_actions {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: var(--space-xs);
	width: 436px;
}
.lanca_hero_backgroung_animation_wrap {
	width: 100%;
}
.lanca_hero_backgroung_animation {
	display: flex;
	flex: 1 0 0;
	align-self: stretch;
	height: 100%;
	min-height: 500px;
	width: 100% !important;
}

@media (min-width: 744px) and (max-width: 1919px) {
	.lanca_hero {
		height: calc(100vh - 48px);
		margin-top: 48px;
	}

	.lanca_hero_title,
	.lanca_hero_title_gray {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}
}

@media (max-width: 744px) {
	.lanca_hero {
		height: calc(100vh - 48px);
		margin-top: 48px;
	}

	.lanca_hero_title,
	.lanca_hero_title_gray {
		font-size: 2rem;
		line-height: 2.25rem;
		letter-spacing: -0.96px;
	}
	.lanca_hero_actions {
		width: 100%;
	}
}

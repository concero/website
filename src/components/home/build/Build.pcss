.home_build {
	display: flex;
	flex-direction: column;

	width: 100%;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m) var(--space-m);
	height: 100%;
	gap: var(--space-xxl);
}

.home_build_title {
	font: var(--font-heading-xxxxlarge);
	text-align: center;
	color: var(--color-gray-light-700);
	@media (max-width: 1919px) {
		font: var(--font-heading-xxxlarge);
	}
	@media (max-width: 343px) {
		font: var(--font-heading-xxlarge);
	}
}

.home_build_content {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xs);
	align-self: stretch;
}

.home_build_content > * {
	flex: 1 1 0;
	min-width: 0;
	box-sizing: border-box;
}

@media (max-width: 640px) {
	.home_build_content {
		flex-direction: column;
	}
	.home_build_content > * {
		flex: 0 0 100%;
		max-width: 100%;
	}
}

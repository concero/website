.home_build {
	display: flex;
	/* min-width: 1280px; */
	max-width: 1920px;
	padding: 64px 0px;
	flex-direction: column;
	align-items: center;
	gap: 32px;
	align-self: stretch;
	background: var(--color-gray-25);

	.block {
		width: calc(100% - 192px - (100% - 544px) / 4);
		overflow: auto;
		border-radius: 24px;
		background:
			radial-gradient(100% 100% at 50% 0%, var(--color-accent-100) 0%, var(--color-gray-25) 100%),
			var(--color-gray-25);
		padding: 32px;
		@media (min-width: 1280px) and (max-width: 1919px) {
			width: calc(100% - 128px - 2 * ((100% - 544px) / 16));
		}
		@media (min-width: 744px) and (max-width: 1279px) {
			width: calc(100% - 64px);
		}
		@media (max-width: 743px) {
			width: calc(100% - 32px);
		}
		.title {
			color: var(--color-gray-700);
			text-align: center;
		}
		.description {
			text-align: center;
			color: var(--color-gray-600);
		}
		.img_block_1 {
			max-width: 100%;
			width: 601px;
			height: 482px;
			aspect-ratio: 101/81;
			@media (min-width: 1280px) and (max-width: 1919px) {
				width: 573.5px;
				height: 460px;
				aspect-ratio: 96/77;
			}
			@media (min-width: 744px) and (max-width: 1279px) {
				width: 573.5px;
				height: 460px;
				aspect-ratio: 96/77;
			}
			@media (max-width: 743px) {
				height: 223.784px;
				align-self: stretch;
				aspect-ratio: 96/77;
			}

			& > * {
				height: 100%;
				max-width: 100%;
			}
		}

		.img_block_2 {
			max-width: 100%;
			width: 870px;
			height: 497px;
			aspect-ratio: 870/497;
			@media (min-width: 1280px) and (max-width: 1919px) {
				width: 764px;
				height: 436px;
				aspect-ratio: 191/109;
			}
			@media (min-width: 744px) and (max-width: 1279px) {
				width: 616px;
				height: 352px;
				aspect-ratio: 7/4;
			}
			@media (max-width: 743px) {
				width: 279px;
				height: 159px;
				aspect-ratio: 93/53;
			}

			& > * {
				max-width: 100%;
			}
		}
		.list {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 32px;

			@media (min-width: 744px) and (max-width: 1279px) {
				grid-template-columns: repeat(2, 1fr);
				column-gap: 32px;
				row-gap: 16px;

				.list_item:last-child {
					grid-column: 1 / -1;
					justify-self: center;
					width: fit-content;
					min-width: 50%;
				}
			}
			@media (max-width: 743px) {
				grid-template-columns: 1fr;
				gap: 16px;
				justify-items: start;
			}

			.list_item {
				min-width: 207px;
				color: var(--color-gray-700);
			}
		}
	}
}

.home_reach {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: calc(var(--space-xxxxxl) + var(--space-xl)) var(--space-m) var(--space-m) var(--space-m);
	height: 100%;
	gap: var(--space-xxl);
}

.home_reach_title {
	font-family: var(--font-heading-large-family);
	font-size: 4rem;
	font-weight: 500;
	line-height: 4.25rem;
	color: var(--color-gray-light-700);
	letter-spacing: -1.28px;
	text-align: center;
}

.home_reach_options {
	display: flex;
	flex-direction: column;
	gap: var(--space-xs);
	width: 100%;
}

.home_reach_protocols {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: var(--space-xs);
	width: 100%;
}

.home_reach_data {
	display: flex;
	gap: var(--space-xs);
	width: 100%;
	min-width: 0;
	flex-wrap: wrap;
}

.home_reach_data > * {
	flex: 1 1 0;
	min-width: 0;
}

/* Partners Section */
.home_reach_partners {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	overflow: hidden;
}

.home_reach_partners_wrapper {
	display: flex;
	width: 100%;
	justify-content: center;
}

.home_reach_partners_track {
	display: flex;
	align-items: center;
	gap: var(--space-xxl);
}

.home_reach_partners_logo {
	flex-shrink: 0;
}

/* Animation for screens < 1195px */
.home_reach_partners--scrolling .home_reach_partners_wrapper {
	justify-content: flex-start;
}

.home_reach_partners--scrolling .home_reach_partners_track {
	animation: marquee-scroll 30s linear infinite;
}

.home_reach_partners--scrolling:hover .home_reach_partners_track {
	animation-play-state: paused;
}

@keyframes marquee-scroll {
	0% {
		transform: translateX(0);
	}
	100% {
		transform: translateX(-50%);
	}
}

/* Media Query Adjustments */
@media (min-width: 1025px) and (max-width: 1919px) {
	.home_reach_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}

	.home_reach_data > :first-child {
		flex: 0 0 33.5%;
		max-width: 33.5%;
	}

	.home_reach_data > :not(:first-child) {
		flex: 1 1 0;
		max-width: calc((100% - 33.5%) / 3);
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.home_reach_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}

	.home_reach_protocols {
		grid-template-columns: 1fr;
	}

	.home_reach_data > :first-child {
		flex: 0 0 100%;
		max-width: 100%;
		order: 0;
	}

	.home_reach_data > :not(:first-child) {
		flex: 0 0 calc((100% - 2 * var(--space-xs)) / 3);
		max-width: calc((100% - 2 * var(--space-xs)) / 3);
		order: 1;
	}

	.home_reach_partners_track {
		gap: var(--space-xl);
	}
}

@media (max-width: 640px) {
	.home_reach_title {
		font-size: 3rem;
		line-height: 3.5rem;
		letter-spacing: -0.96px;
	}

	.home_reach_protocols {
		grid-template-columns: 1fr;
	}

	.home_reach_data > * {
		flex: 0 0 100%;
		max-width: 100%;
	}

	.home_reach_partners_track {
		gap: var(--space-xl);
	}
}

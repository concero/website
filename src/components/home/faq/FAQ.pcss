.lanca_faq {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 64px 386px;
	width: 100%;
	gap: var(--space-xxxl);
	@media (min-width: 1280px) and (max-width: 1919px) {
		padding: 64px 266px;
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		padding: 64px 121px;
	}
	@media (max-width: 743px) {
		padding: 32px 16px;
	}
}

.lanca_faq_title {
	color: var(--color-gray-light-700);
	font: var(--font-heading-xxxlarge);
	letter-spacing: -0.96px;
	@media (min-width: 1280px) and (max-width: 1919px) {
		font: var(--font-heading-xxlarge);
		letter-spacing: -0.64px;
	}
	@media (min-width: 744px) and (max-width: 1279px) {
		font: var(--font-heading-xxlarge);
		letter-spacing: -0.64px;
	}
	@media (max-width: 743px) {
		font: var(--font-heading-xxlarge);
		letter-spacing: -0.64px;
	}
}
